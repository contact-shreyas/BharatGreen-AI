# NVIDIA NIM API — powers the Nemotron agent everywhere:
#   • /workloads/analyze        (footprint analysis)
#   • /agent/auto-optimize      (autonomous region×GPU×schedule optimiser)
#   • /agent/parse-workload     (natural-language → structured workload)
#   • /prompt/optimize          (Green Prompt Optimizer rewrite)
# All endpoints fall back to deterministic offline engines when this is unset,
# so the demo always works without a key.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Use a FAST instruct model — the UI aborts agent calls at ~20s. Reasoning
# models (nemotron-nano/super/ultra) take 25–120s and time out. mini-4b-instruct
# responds in <1s and is the verified default.
NVIDIA_MODEL=nvidia/nemotron-mini-4b-instruct

# LLM that answers the optimized prompt in the Green Prompt Optimizer.
# Provider: "gemini" (free, default) or "anthropic".
LLM_PROVIDER=gemini
# LLM_MAX_TOKENS=1024

# Google Gemini — FREE key from https://aistudio.google.com (no billing card needed).
# Set this once on the server so every user gets live answers with no setup.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — optional fallback (needs prepaid API credits, not Claude Pro).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# App settings
APP_ENV=production
CORS_ORIGINS=*

# Port — Render sets this automatically; default 8000 for local dev
# PORT=8000
